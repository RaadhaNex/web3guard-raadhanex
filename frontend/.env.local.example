NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_UPI_ID=yourupi@bank
NEXT_PUBLIC_UPI_NAME=RAADHANEX

# Real Supabase Auth/client. Leave blank to show Provider Not Configured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local dashboard fallback only for backend developer mode. Do not use for private production data.
NEXT_PUBLIC_LOCAL_DEMO_USER_ID=local-demo-user

# Public Razorpay key id is safe for Checkout UI; never expose RAZORPAY_KEY_SECRET.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_ENABLED=false

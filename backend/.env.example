# ═══ Web3Guard AI — Environment Variables ═══
# Copy to .env and fill in values before running.
# Never commit real secrets.

# ── App ──────────────────────────────────────
APP_NAME=Web3Guard AI
APP_ENV=development
BACKEND_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# ── Admin ────────────────────────────────────
ADMIN_TOKEN=change-this-secret-token

# ── Supabase ─────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_VERIFY_ENABLED=false

# ── Rate limiting ────────────────────────────
MAX_URL_SCAN_PER_HOUR=20

# ── Scanner tools: all OFF by default ────────
# Set WORKER_EXECUTION_ENABLED=true only when isolated worker + binaries are installed.
WORKER_EXECUTION_ENABLED=false
STATIC_ANALYSIS_ENABLED=false
SLITHER_ENABLED=false
ADERYN_ENABLED=false
SEMGREP_ENABLED=false
MYTHRIL_ENABLED=false
MYTHRIL_DOCKER_ENABLED=false
MANTICORE_ENABLED=false
ECHIDNA_ENABLED=false
FOUNDRY_ENABLED=false
DEEP_ANALYSIS_ENABLED=false

# ── Optional API keys ────────────────────────
ETHERSCAN_API_KEY=
GITHUB_API_TOKEN=

# ── AI: OFF by default ───────────────────────
AI_ENABLED=false
AI_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Payments: DEFERRED — do not activate yet ─
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_MODE=disabled

# ── External providers ───────────────────────
GOPLUS_ENABLED=false
GOPLUS_API_KEY=

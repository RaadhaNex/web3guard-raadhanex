APP_NAME="Web3Guard AI by RAADHANEX"
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Change before any public deployment. This token protects /admin/* APIs.
ADMIN_TOKEN=change-this-admin-token

# MVP local storage. Supabase/PostgreSQL comes in the next SaaS phases.
LEADS_FILE=app/data/leads.jsonl
OWNERSHIP_CHALLENGES_FILE=app/data/ownership_challenges.jsonl

# UPI manual payment workflow. Replace before real payment testing.
RAADHANEX_UPI_ID=yourupi@bank
RAADHANEX_UPI_NAME=RAADHANEX
PAYMENT_MODE=upi_manual
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE=https://api.razorpay.com/v1
PAYMENT_INTENTS_FILE=app/data/payment_intents.jsonl
PAYMENT_EVENTS_FILE=app/data/payment_events.jsonl
SUBSCRIPTIONS_FILE=app/data/subscriptions.jsonl

# AI is optional. If disabled, scanner uses local fallback explanations only.
AI_ENABLED=false
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
AI_TIMEOUT_SECONDS=20
AI_SEND_CODE=false

# Safety limits
MAX_CODE_CHARS=60000
MAX_URL_SCAN_PER_HOUR=20
MAX_CONTRACT_SCAN_PER_HOUR=60
MAX_CHECKLIST_SCAN_PER_HOUR=80
MAX_PERMISSION_MAP_SCAN_PER_HOUR=40
WEBSITE_SCAN_TIMEOUT_SECONDS=8
WEBSITE_SCAN_MAX_BODY_BYTES=750000
WEBSITE_SCAN_EXTERNAL_SCRIPT_WARNING_THRESHOLD=12
WEBSITE_SCANNER_USER_AGENT=Web3GuardAI-RAADHANEX-PassiveScanner/phase6 (+https://web3guard.ai; passive-check-only; owner-verification-ready)

# Phase 7 — Auth + Database foundation.
# Default local mode keeps the project runnable without cloud setup.
STORAGE_MODE=local
LOCAL_DEMO_USER_ID=local-demo-user
DB_PROFILES_FILE=app/data/db/profiles.jsonl
DB_PROJECTS_FILE=app/data/db/projects.jsonl
DB_SCAN_HISTORY_FILE=app/data/db/scan_history.jsonl
DB_SAVED_REPORTS_FILE=app/data/db/saved_reports.jsonl

# Set these for real Supabase Auth + database.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_VERIFY_ENABLED=false
SUPABASE_AUTH_REQUIRED=false

# Phase 7.2 local-first workspace storage
DB_ORGANIZATIONS_FILE=app/data/db/organizations.jsonl
DB_ORG_MEMBERS_FILE=app/data/db/org_members.jsonl
DB_FINDING_TASKS_FILE=app/data/db/finding_tasks.jsonl
DB_WORKSPACE_COMMENTS_FILE=app/data/db/workspace_comments.jsonl
DB_WORKSPACE_ACTIVITY_FILE=app/data/db/workspace_activity.jsonl

# Phase 9 professional/public report storage
PUBLIC_REPORTS_FILE=app/data/db/public_reports.jsonl

# Phase 10 SecureScore Pro dashboard + finding workflow storage
DB_FINDING_WORKFLOW_FILE=app/data/db/finding_workflow.jsonl

# Phase 11 — GitHub public repository scanner.
# GITHUB_API_TOKEN is optional for public repos, but recommended to avoid GitHub API rate limits.
GITHUB_API_BASE=https://api.github.com
GITHUB_API_TOKEN=
GITHUB_SCAN_TIMEOUT_SECONDS=12
MAX_GITHUB_SCAN_PER_HOUR=20
MAX_GITHUB_FILES=1200
MAX_GITHUB_FILE_BYTES=180000
MAX_GITHUB_TOTAL_BYTES=900000
MAX_GITHUB_SOLIDITY_FILES=8
MAX_GITHUB_CONTRACT_FINDINGS_PER_FILE=10
MAX_GITHUB_PACKAGE_FILES=4
MAX_GITHUB_API_FILES=16
MAX_GITHUB_FRONTEND_FILES=16


# Phase 12: Contract address scanner (Etherscan API V2 unified multichain key).
# Get API key from Etherscan. Keep backend-only. Do not put this in frontend env.
ETHERSCAN_API_KEY=
ETHERSCAN_V2_API_BASE=https://api.etherscan.io/v2/api
EXPLORER_SCAN_TIMEOUT_SECONDS=15
MAX_CONTRACT_ADDRESS_SCAN_PER_HOUR=25
MAX_EXPLORER_SOURCE_CHARS=350000

# Phase 13: Real static analysis tools. Disabled by default to avoid fake tool output.
STATIC_ANALYSIS_ENABLED=false
SLITHER_ENABLED=true
ADERYN_ENABLED=false
SEMGREP_ENABLED=true
SLITHER_BINARY=
ADERYN_BINARY=
SEMGREP_BINARY=
ADERYN_COMMAND_TEMPLATE={binary} --root {root} --output {output}
AUDIT_TOOL_TIMEOUT_SECONDS=45
AUDIT_TOOL_CLEANUP_WORKSPACE=true
MAX_STATIC_ANALYSIS_SCAN_PER_HOUR=12


# Phase 14 deep analysis tools - disabled by default, no fake output.
DEEP_ANALYSIS_ENABLED=false
MYTHRIL_ENABLED=false
MANTICORE_ENABLED=false
ECHIDNA_ENABLED=false
MYTHRIL_BINARY=
MANTICORE_BINARY=
ECHIDNA_BINARY=
MYTHRIL_COMMAND_TEMPLATE={binary} analyze {source} -o json
MYTHRIL_WORKER_REQUIRED=true
MYTHRIL_ALLOW_LOCAL_EXECUTION=false
MYTHRIL_DOCKER_ENABLED=false
MYTHRIL_DOCKER_BINARY=docker
MYTHRIL_DOCKER_IMAGE=
MANTICORE_COMMAND_TEMPLATE={binary} {source}
ECHIDNA_COMMAND_TEMPLATE={binary} {source} --format json
DEEP_ANALYSIS_TIMEOUT_SECONDS=120
DEEP_ANALYSIS_NETWORK_ENABLED=false
DEEP_ANALYSIS_ALLOW_DEPENDENCY_INSTALL=false
MAX_DEEP_ANALYSIS_SCAN_PER_HOUR=6

# Phase 15: Real AI Fix Assistant. Disabled by default; fallback guidance remains local.
# Real provider calls require AI_ENABLED=true + AI_FIX_ENABLED=true + provider key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_FIX_ENABLED=false
AI_FIX_SEND_CODE=false
AI_FIX_MAX_CODE_CHARS=12000

# Mega Phase B — Advanced website/API/wallet intelligence
ADVANCED_WEBSITE_EXTERNAL_DOMAIN_WARNING_THRESHOLD=10
ADVANCED_WEBSITE_INLINE_SCRIPT_WARNING_THRESHOLD=8
MAX_ADVANCED_WEBSITE_SCAN_PER_HOUR=15
API_DEEP_SCAN_TIMEOUT_SECONDS=8
MAX_API_DEEP_SCAN_PER_HOUR=20
MAX_API_DEEP_OPENAPI_CHARS=220000
GOPLUS_ENABLED=false
GOPLUS_API_BASE=https://api.gopluslabs.io
GOPLUS_ACCESS_TOKEN=
WALLET_RISK_API_TIMEOUT_SECONDS=10
MAX_WALLET_RISK_API_SCAN_PER_HOUR=25

# Mega Phase C — Phase 23 Monitoring Lite + Phase 24 Threat Intelligence
MONITORING_ENABLED=false
MONITORING_RPC_ENABLED=false
MONITORING_CONFIGS_FILE=app/data/db/monitoring_configs.jsonl
MONITORING_ALERTS_FILE=app/data/db/monitoring_alerts.jsonl
MONITORING_EVENTS_FILE=app/data/db/monitoring_events.jsonl
MONITORING_MAX_BLOCK_WINDOW=1200
MONITORING_DEFAULT_BLOCK_LOOKBACK=200
MAX_MONITORING_CONFIG_PER_HOUR=20
MAX_MONITORING_CHECK_PER_HOUR=20
ETHEREUM_RPC_URL=
POLYGON_RPC_URL=
BSC_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
BASE_RPC_URL=
AVALANCHE_RPC_URL=

THREAT_INTEL_ENABLED=true
THREAT_INTEL_LIVE_SOURCES_ENABLED=false
THREAT_INTEL_FILE=app/data/db/threat_intel.jsonl
MAX_THREAT_INTEL_ADMIN_WRITES_PER_HOUR=30

# Mega Phase E — CI/CD, Learning Center, Admin Super Panel v2
LEARNING_PROGRESS_FILE=app/data/db/learning_progress.jsonl
ADMIN_FEATURE_FLAGS_FILE=app/data/db/admin_feature_flags.jsonl
ADMIN_AUDIT_LOG_FILE=app/data/db/admin_audit_log.jsonl
ADMIN_SUPER_PANEL_ENABLED=true
CICD_TEMPLATE_ENABLED=true
LEARNING_CENTER_ENABLED=true

# Mega Phase F — Notifications
NOTIFICATIONS_ENABLED=true
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=none
WHATSAPP_API_TOKEN=
WHATSAPP_FROM_NUMBER=

# Mega Phase F — Compliance Scanner
MAX_COMPLIANCE_SCAN_PER_HOUR=40

# Mega Phase F — Cross-chain Support
CROSS_CHAIN_EVM_ENABLED=true
CROSS_CHAIN_SOLANA_CHECKLIST_ENABLED=true
CROSS_CHAIN_MOVE_CHECKLIST_ENABLED=true
MAX_CROSS_CHAIN_SCAN_PER_HOUR=40

# Mega Phase G — Platform Security Hardening + Final Production QA
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000
SECURITY_CSP=default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
MAX_REQUEST_BODY_BYTES=5000000
RATE_LIMIT_BACKEND=memory
DEFAULT_DATA_RETENTION_DAYS=90
PRODUCTION_LAUNCH_ACKNOWLEDGED=false


# Mega Phase G — Platform Security Hardening + Final QA
PRODUCTION_HARDENING_ENABLED=true
SECURITY_HEADERS_ENABLED=true
CONTENT_SECURITY_POLICY_REPORT_ONLY=true
PRODUCTION_CORS_LOCK_REQUIRED=true
DATA_RETENTION_ENABLED=true
CODE_UPLOAD_RETENTION_DAYS=7
SCAN_HISTORY_RETENTION_DAYS=180
LEAD_RETENTION_DAYS=365
PAYMENT_RECORD_RETENTION_DAYS=1825
AUDIT_LOG_RETENTION_DAYS=365
USER_DATA_DELETE_REQUEST_SLA_DAYS=30
BACKUP_POLICY_ENABLED=false
BACKUP_PROVIDER=manual
SENTRY_ENABLED=false
SENTRY_DSN=
UPTIME_MONITORING_ENABLED=false
PRODUCTION_LAUNCH_APPROVED=false
FINAL_QA_OWNER=RAADHANEX admin
